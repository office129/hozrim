// Prisma schema for Hozrim LeBereshit — client companion app + admin panel.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  resetTokens AdminPasswordResetToken[]
}

model Client {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  name              String
  avatarUrl         String?
  hasSeenProfileTip Boolean  @default(false)
  totalSessions     Int      @default(6)
  createdAt         DateTime @default(now())

  sessions    LessonSession[]
  exercises   Exercise[]
  journal     JournalEntry[]
  resetTokens PasswordResetToken[]
  passkeys    ClientPasskey[]
}

// A registered biometric/fingerprint login (WebAuthn credential) — the
// client can add one from their profile after logging in with a password,
// then use it to sign in afterward without typing anything.
model ClientPasskey {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  transports   String?
  createdAt    DateTime @default(now())
}

// A single meeting/lesson in a client's personal process — the
// "פגישות והקלטות" tab in admin and "הקלטות" in the client app.
model LessonSession {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number    Int
  title     String

  mediaType     String? // "video" | "audio" — which upload slot is active
  fileUrl       String?
  fileName      String?
  durationSec   Int?

  summaryText     String?
  summaryFileUrl  String?
  summaryFileName String?

  completed  Boolean @default(false)
  clientNote String?

  createdAt DateTime @default(now())

  @@index([clientId, number])
}

// Per-client practice/exercise items — the "תרגולים" tab.
model Exercise {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number   Int
  title    String
  subtitle String?

  audioFileUrl  String?
  audioFileName String?
  pdfFileUrl    String?
  pdfFileName   String?

  createdAt DateTime @default(now())

  @@index([clientId, number])
}

// The general opening-content template shown to every client under
// "תחילת התהליך" — managed from the admin "ספריית תכנים" screen.
model LibraryItem {
  id     String @id @default(cuid())
  number Int
  title  String

  videoFileUrl  String?
  videoFileName String?
  audioFileUrl  String?
  audioFileName String?
  fileUrl       String?
  fileName      String?

  createdAt DateTime @default(now())
}

// Fully private per-client journal — never exposed to the admin panel.
model JournalEntry {
  id       String   @id @default(cuid())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  text     String
  createdAt DateTime @default(now())

  @@index([clientId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([clientId])
}

model AdminPasswordResetToken {
  id        String    @id @default(cuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}
