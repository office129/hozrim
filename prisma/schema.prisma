// Prisma schema for Hozrim LeBereshit — client companion app + admin panel.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  resetTokens AdminPasswordResetToken[]
}

model Client {
  id                           String   @id @default(cuid())
  email                        String   @unique
  passwordHash                 String
  name                         String
  avatarUrl                    String?
  hasSeenProfileTip            Boolean  @default(false)
  hasSeenSessionCompleteTip    Boolean  @default(false)
  hasSeenWelcomePopup          Boolean  @default(false)
  hasSeededWelcomeNotification Boolean  @default(false)
  hasSeenPushHint              Boolean  @default(false)
  totalSessions                Int      @default(6)
  createdAt                    DateTime @default(now())

  sessions               LessonSession[]
  exercises              Exercise[]
  journal                JournalEntry[]
  personalUploadGroups   PersonalUploadGroup[]
  resetTokens            PasswordResetToken[]
  passkeys               ClientPasskey[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  driveFolderId          String? // the client's top-level Drive folder
  driveExercisesFolderId String? // the "תרגולים" subfolder inside driveFolderId
  driveMeetingsFolderId  String? // the "פגישות והקלטות" subfolder inside driveFolderId — each session gets its own "פגישה N" folder inside this one
  driveUploadsFolderId   String? // the "ההעלאות שלי" subfolder inside driveFolderId — created lazily, only the first time the client uploads something personal (not in driveFolderId at client creation, unlike the other two subfolders)
}

// A notification shown in the client app's bell icon - either triggered
// automatically (a new session/exercise became available) or sent by the
// coach to every client at once ("broadcast"). One row per client even
// for a broadcast, so read state is just a plain per-row timestamp with
// no separate join table needed.
model Notification {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      String // "session" | "exercise" | "broadcast" | "welcome"
  title     String
  link      String? // in-app path to navigate to when clicked, e.g. "/app/recordings/<id>"
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId, createdAt])
}

// A device's Web Push subscription - lets the server push a real phone/
// browser notification for a new Notification row, not just the in-app
// bell. One row per device (a client using the app on two phones gets
// two rows); on iOS this only works once the client has actually
// installed the app to their home screen, not just visiting it in Safari.
model PushSubscription {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([clientId])
}

// The coach's own Google Drive, connected once via OAuth so the server can
// write recordings directly into it (using the coach's real storage quota)
// instead of proxying through Vercel Blob. Single row — one practice, one
// Drive.
model GoogleDriveConnection {
  id                     String   @id @default(cuid())
  connectedEmail         String
  refreshToken           String
  createdAt              DateTime @default(now())
  meetRecordingsFolderId String? // the "Meet Recordings" folder shared with this account by whoever organizes the actual Meet calls — scanned daily for new recordings to auto-file
  clientsParentFolderId  String? // the top-level "חוזרים לבראשית - לקוחות" folder, persisted by ID once found/created so renaming it in Drive later doesn't cause a name-based lookup to miss it and create a duplicate
  libraryFolderId        String? // the "ספריית תכנים" folder, same idea as clientsParentFolderId
}

// A log of every Meet recording the daily import job has looked at, so it
// never processes the same Drive file twice. "matched" means it was
// copied into a client's session automatically (name found, exactly one
// client); "ambiguous"/"unmatched" need an admin to pick the right client
// (or dismiss it) from the review queue; "ignored" is a dismissed one.
model MeetRecordingImport {
  id            String    @id @default(cuid())
  driveFileId   String    @unique
  fileName      String
  recordingDate DateTime?
  status        String
  matchedNames  String? // comma-separated client names the filename matched, shown to the admin when reviewing an ambiguous/unmatched one
  clientId      String?
  sessionId     String?
  createdAt     DateTime  @default(now())

  @@index([status])
}

// A registered biometric/fingerprint login (WebAuthn credential) — the
// client can add one from their profile after logging in with a password,
// then use it to sign in afterward without typing anything.
model ClientPasskey {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  transports   String?
  createdAt    DateTime @default(now())
}

// A single meeting/lesson in a client's personal process — the
// "פגישות והקלטות" tab in admin and "הקלטות" in the client app.
model LessonSession {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number   Int
  title    String

  mediaType     String? // "video" | "audio" — which upload slot is active
  fileUrl       String?
  fileName      String?
  durationSec   Int?
  driveFolderId String? // this session's own Drive folder — cached so the sync job doesn't have to look it up by name every run

  summaryText  String?
  summaryFiles SessionSummaryFile[]

  completed  Boolean @default(false)
  clientNote String?

  createdAt DateTime @default(now())

  @@index([clientId, number])
}

// One PDF summary document attached to a session — a session can have
// more than one (e.g. two separate summary files from the same meeting).
model SessionSummaryFile {
  id        String        @id @default(cuid())
  sessionId String
  session   LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  order     Int
  createdAt DateTime      @default(now())

  @@index([sessionId, order])
}

// Per-client practice/exercise items — the "תרגולים" tab.
model Exercise {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number   Int
  title    String
  subtitle String?

  audioFileUrl  String?
  audioFileName String?
  pdfFileUrl    String?
  pdfFileName   String?

  createdAt DateTime @default(now())

  @@index([clientId, number])
}

// The general opening-content template shown to every client under
// "תחילת התהליך" — managed from the admin "ספריית תכנים" screen.
model LibraryItem {
  id     String @id @default(cuid())
  number Int
  title  String

  videoFileUrl  String?
  videoFileName String?
  audioFileUrl  String?
  audioFileName String?
  fileUrl       String?
  fileName      String?
  driveFolderId String? // this item's own Drive folder — cached so the sync job doesn't have to look it up by name every run

  createdAt DateTime @default(now())
}

// Fully private per-client journal — never exposed to the admin panel.
model JournalEntry {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([clientId])
}

// A named group of the client's own personal files, uploaded from the
// journal tab for their own use - same privacy as JournalEntry, never
// exposed to the admin panel. Same shape as LessonSession/
// SessionSummaryFile: one folder per named group inside "ההעלאות שלי"
// (itself lazily created the first time the client uploads anything),
// holding one or more files the client considers related.
model PersonalUploadGroup {
  id            String           @id @default(cuid())
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title         String
  driveFolderId String? // this group's own Drive folder, cached once created
  files         PersonalUpload[]
  createdAt     DateTime         @default(now())

  @@index([clientId, createdAt])
}

model PersonalUpload {
  id        String              @id @default(cuid())
  groupId   String
  group     PersonalUploadGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  mediaType String // "video" | "audio" | "document"
  createdAt DateTime            @default(now())

  @@index([groupId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
}

model AdminPasswordResetToken {
  id        String    @id @default(cuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}
