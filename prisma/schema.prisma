// Prisma schema for Hozrim LeBereshit — client companion app + admin panel.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  resetTokens AdminPasswordResetToken[]
}

model Client {
  id                        String   @id @default(cuid())
  email                     String   @unique
  passwordHash              String
  name                      String
  avatarUrl                 String?
  hasSeenProfileTip         Boolean  @default(false)
  hasSeenSessionCompleteTip Boolean  @default(false)
  totalSessions             Int      @default(6)
  createdAt                 DateTime @default(now())

  sessions               LessonSession[]
  exercises              Exercise[]
  journal                JournalEntry[]
  resetTokens            PasswordResetToken[]
  passkeys               ClientPasskey[]
  driveFolderId          String? // the client's top-level Drive folder
  driveExercisesFolderId String? // the "תרגולים" subfolder inside driveFolderId
  driveMeetingsFolderId  String? // the "פגישות והקלטות" subfolder inside driveFolderId — each session gets its own "פגישה N" folder inside this one
}

// The coach's own Google Drive, connected once via OAuth so the server can
// write recordings directly into it (using the coach's real storage quota)
// instead of proxying through Vercel Blob. Single row — one practice, one
// Drive.
model GoogleDriveConnection {
  id                     String   @id @default(cuid())
  connectedEmail         String
  refreshToken           String
  createdAt              DateTime @default(now())
  meetRecordingsFolderId String? // the "Meet Recordings" folder shared with this account by whoever organizes the actual Meet calls — scanned daily for new recordings to auto-file
}

// A log of every Meet recording the daily import job has looked at, so it
// never processes the same Drive file twice. "matched" means it was
// copied into a client's session automatically (name found, exactly one
// client); "ambiguous"/"unmatched" need an admin to pick the right client
// (or dismiss it) from the review queue; "ignored" is a dismissed one.
model MeetRecordingImport {
  id            String    @id @default(cuid())
  driveFileId   String    @unique
  fileName      String
  recordingDate DateTime?
  status        String
  matchedNames  String? // comma-separated client names the filename matched, shown to the admin when reviewing an ambiguous/unmatched one
  clientId      String?
  sessionId     String?
  createdAt     DateTime  @default(now())

  @@index([status])
}

// A registered biometric/fingerprint login (WebAuthn credential) — the
// client can add one from their profile after logging in with a password,
// then use it to sign in afterward without typing anything.
model ClientPasskey {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  transports   String?
  createdAt    DateTime @default(now())
}

// A single meeting/lesson in a client's personal process — the
// "פגישות והקלטות" tab in admin and "הקלטות" in the client app.
model LessonSession {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number    Int
  title     String

  mediaType     String? // "video" | "audio" — which upload slot is active
  fileUrl       String?
  fileName      String?
  durationSec   Int?
  driveFolderId String? // this session's own Drive folder — cached so the sync job doesn't have to look it up by name every run

  summaryText  String?
  summaryFiles SessionSummaryFile[]

  completed  Boolean @default(false)
  clientNote String?

  createdAt DateTime @default(now())

  @@index([clientId, number])
}

// One PDF summary document attached to a session — a session can have
// more than one (e.g. two separate summary files from the same meeting).
model SessionSummaryFile {
  id        String        @id @default(cuid())
  sessionId String
  session   LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  order     Int
  createdAt DateTime      @default(now())

  @@index([sessionId, order])
}

// Per-client practice/exercise items — the "תרגולים" tab.
model Exercise {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number   Int
  title    String
  subtitle String?

  audioFileUrl  String?
  audioFileName String?
  pdfFileUrl    String?
  pdfFileName   String?

  createdAt DateTime @default(now())

  @@index([clientId, number])
}

// The general opening-content template shown to every client under
// "תחילת התהליך" — managed from the admin "ספריית תכנים" screen.
model LibraryItem {
  id     String @id @default(cuid())
  number Int
  title  String

  videoFileUrl  String?
  videoFileName String?
  audioFileUrl  String?
  audioFileName String?
  fileUrl       String?
  fileName      String?
  driveFolderId String? // this item's own Drive folder — cached so the sync job doesn't have to look it up by name every run

  createdAt DateTime @default(now())
}

// Fully private per-client journal — never exposed to the admin panel.
model JournalEntry {
  id       String   @id @default(cuid())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  text     String
  createdAt DateTime @default(now())

  @@index([clientId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([clientId])
}

model AdminPasswordResetToken {
  id        String    @id @default(cuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}
