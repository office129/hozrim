DATABASE_URL="postgresql://user:password@localhost:5432/hozrim"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Local-disk fallback for uploaded video/audio/PDF files, used only when
# BLOB_READ_WRITE_TOKEN (below) is not set — fine for local development,
# but does NOT persist on serverless hosts like Vercel.
UPLOAD_DIR="./storage/uploads"

# Vercel Blob storage token — set this (Vercel adds it automatically when
# you attach a Blob store to the project) to store uploads there instead
# of local disk. Required for a real deployment.
# BLOB_READ_WRITE_TOKEN=

# Real transactional email (password reset / new client & team credentials).
# When none of these are set, these flows log the message to the server
# console instead of actually sending it.
#
# Option A — Resend (recommended, simplest for Vercel): sign up at
# resend.com, create an API key, and set it here. Until you verify your own
# sending domain, Resend's free tier only delivers to the email address you
# signed up with — fine for testing, but real clients need a verified domain.
# RESEND_API_KEY=

# Option B — SMTP (used only if RESEND_API_KEY is not set):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Sender shown on outgoing emails (used by either option above):
# MAIL_FROM="חוזרים לבראשית <no-reply@example.com>"
