DATABASE_URL="file:./dev.db"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
UPLOAD_DIR="./storage/uploads"

# Optional: SMTP for real transactional email (password reset / new client credentials).
# When unset, these flows log the message to the server console instead of sending it.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="חוזרים לבראשית <no-reply@example.com>"
