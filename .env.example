DATABASE_URL="postgresql://user:password@localhost:5432/hozrim"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Local-disk fallback for uploaded video/audio/PDF files, used only when
# BLOB_READ_WRITE_TOKEN (below) is not set — fine for local development,
# but does NOT persist on serverless hosts like Vercel.
UPLOAD_DIR="./storage/uploads"

# Vercel Blob storage token — set this (Vercel adds it automatically when
# you attach a Blob store to the project) to store uploads there instead
# of local disk. Required for a real deployment.
# BLOB_READ_WRITE_TOKEN=

# Optional: SMTP for real transactional email (password reset / new client credentials).
# When unset, these flows log the message to the server console instead of sending it.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="חוזרים לבראשית <no-reply@example.com>"
